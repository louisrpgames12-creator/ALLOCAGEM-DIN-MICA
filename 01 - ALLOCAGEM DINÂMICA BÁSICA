#include <stdio.h>
#include <stdlib.h>


int main() {
    int tam, *vet;

    printf("ME INFORME O TAMANHO DE UM VETOR: ");
    scanf("%d", &tam);
    vet = malloc(tam * sizeof(int));
    for(int i = 0; i < tam; i++) {
        printf("ME INFORME OS VALORES %d: ", i + 1);
        scanf("%d", vet + i);
    }
    printf("\n");
    for(int i = 0; i < tam; i++) {
        printf("%d  ", *(vet + i));;
    }
    
    return 0;
}
